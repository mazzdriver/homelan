{
  "name": "homelan-workspace",
  "version": "2.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "homelan-workspace",
      "version": "2.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@homelan/admin": {
      "resolved": "packages/homelan-admin",
      "link": true
    },
    "node_modules/@homelan/client": {
      "resolved": "packages/homelan-client",
      "link": true
    },
    "node_modules/@homelan/protocol": {
      "resolved": "packages/homelan-protocol",
      "link": true
    },
    "packages/homelan-admin": {
      "name": "@homelan/admin",
      "version": "2.1.0",
      "bin": {
        "homelan": "bin/homelan.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/homelan-client": {
      "name": "@homelan/client",
      "version": "2.1.0",
      "bin": {
        "homelan-client": "bin/homelan-client.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/homelan-protocol": {
      "name": "@homelan/protocol",
      "version": "2.1.0",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
